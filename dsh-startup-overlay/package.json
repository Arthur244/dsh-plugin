{
  "name": "dsh-startup-overlay",
  "version": "0.2.0",
  "description": "保持首次启动 loading，等待共享设置与账号首次状态后再挂载界面；8 秒内就绪即放行，错误、超时或卸载安全放行，不修改遮罩或交互锁。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check && node --check index.js && node --check client.js",
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": [] }
  },
  "engines": { "dsh": "0.2.2-rc.3" },
  "license": "MIT"
}
